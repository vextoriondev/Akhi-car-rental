# Postgres (Neon via Vercel Storage -> sets POSTGRES_URL automatically)
POSTGRES_URL=postgres://user:password@host/db?sslmode=require
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, digits only (e.g. 8801XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801000000000
# Vercel Blob (for uploaded images in production). Auto-set when you add a Blob store.
BLOB_READ_WRITE_TOKEN=
# Set to "true" on the FIRST deploy so Payload creates DB tables, then remove it
PAYLOAD_PUSH=false
