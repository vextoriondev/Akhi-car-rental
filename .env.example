# Postgres (Neon via Vercel Storage sets POSTGRES_URL automatically)
POSTGRES_URL=postgres://user:password@host/db?sslmode=require
# Long random string, e.g. `openssl rand -hex 32` (required in production)
PAYLOAD_SECRET=change-me
# Public site URL, no trailing slash. Used for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp fallback if Site Settings cannot be read (international format, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801625347735
# Vercel Blob. REQUIRED on Vercel to upload photos in the admin panel.
BLOB_READ_WRITE_TOKEN=
# In development the database schema is updated automatically. Set to false to stop that.
# Production never updates the schema automatically: run `npm run db:migrate`.
# PAYLOAD_PUSH=false
# Only used by `npm run seed` / `npm run admin:bootstrap` to create the first admin (12+ characters)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
